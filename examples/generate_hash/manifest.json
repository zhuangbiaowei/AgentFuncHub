{
  "function_id": "func-012-hash-generator",
  "name": "generate_hash",
  "display_name": "哈希值生成器",
  "description": "生成数据的哈希值，支持 MD5、SHA1、SHA256 等多种算法，支持字符串和二进制数据。",
  "language": "python",
  "version": "1.0.0",
  "signature": {
    "inputs": [
      {
        "name": "data",
        "type": "str",
        "description": "待哈希的数据",
        "required": true
      },
      {
        "name": "algorithm",
        "type": "str",
        "description": "哈希算法（md5/sha1/sha256/sha512）",
        "required": false,
        "default": "sha256"
      },
      {
        "name": "encoding",
        "type": "str",
        "description": "数据编码（utf-8/base64/hex）",
        "required": false,
        "default": "utf-8"
      }
    ],
    "outputs": [
      {
        "name": "hash_value",
        "type": "str",
        "description": "哈希值（十六进制字符串）"
      },
      {
        "name": "algorithm",
        "type": "str",
        "description": "使用的算法"
      },
      {
        "name": "length",
        "type": "int",
        "description": "哈希值长度"
      }
    ]
  },
  "code": {
    "source": "import hashlib\nimport base64\nfrom typing import Tuple\n\ndef generate_hash(\n    data: str, \n    algorithm: str = 'sha256',\n    encoding: str = 'utf-8'\n) -> Tuple[str, str, int]:\n    \"\"\"\n    生成数据的哈希值。\n    \"\"\"\n    if not data:\n        return '', algorithm, 0\n    \n    # 根据编码转换数据\n    if encoding == 'base64':\n        try:\n            data_bytes = base64.b64decode(data)\n        except:\n            data_bytes = data.encode('utf-8')\n    elif encoding == 'hex':\n        try:\n            data_bytes = bytes.fromhex(data)\n        except:\n            data_bytes = data.encode('utf-8')\n    else:\n        data_bytes = data.encode('utf-8')\n    \n    # 选择算法\n    hash_obj = None\n    if algorithm == 'md5':\n        hash_obj = hashlib.md5(data_bytes)\n    elif algorithm == 'sha1':\n        hash_obj = hashlib.sha1(data_bytes)\n    elif algorithm == 'sha256':\n        hash_obj = hashlib.sha256(data_bytes)\n    elif algorithm == 'sha512':\n        hash_obj = hashlib.sha512(data_bytes)\n    else:\n        raise ValueError(f'Unsupported algorithm: {algorithm}')\n    \n    hash_value = hash_obj.hexdigest()\n    return hash_value, algorithm, len(hash_value)",
    "hash": "sha256:placeholder",
    "line_count": 45,
    "complexity": 3.0
  },
