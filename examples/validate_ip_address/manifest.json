{
  "function_id": "func-004-ip-validator",
  "name": "validate_ip_address",
  "display_name": "IP 地址验证器",
  "description": "验证 IPv4 和 IPv6 地址格式，支持检查是否为私有地址、保留地址或公网地址。",
  "language": "python",
  "version": "1.0.0",
  "signature": {
    "inputs": [
      {
        "name": "ip",
        "type": "str",
        "description": "待验证的 IP 地址",
        "required": true
      },
      {
        "name": "allow_private",
        "type": "bool",
        "description": "是否允许私有地址",
        "required": false,
        "default": true
      }
    ],
    "outputs": [
      {
        "name": "is_valid",
        "type": "bool",
        "description": "是否为有效 IP 地址"
      },
      {
        "name": "version",
        "type": "int",
        "description": "IP 版本（4 或 6），无效则为 0"
      },
      {
        "name": "is_private",
        "type": "bool",
        "description": "是否为私有地址"
      },
      {
        "name": "type",
        "type": "str",
        "description": "地址类型（public/private/loopback/multicast/reserved）"
      }
    ]
  },
  "code": {
    "source": "import ipaddress\nfrom typing import Tuple\n\ndef validate_ip_address(ip: str, allow_private: bool = True) -> Tuple[bool, int, bool, str]:\n    \"\"\"\n    验证 IP 地址并返回详细信息。\n    \"\"\"\n    if not ip or not isinstance(ip, str):\n        return False, 0, False, 'invalid'\n    \n    try:\n        # 尝试 IPv4\n        addr = ipaddress.ip_address(ip)\n        version = addr.version\n        is_private = addr.is_private\n        \n        # 确定类型\n        if addr.is_loopback:\n            ip_type = 'loopback'\n        elif addr.is_multicast:\n            ip_type = 'multicast'\n        elif addr.is_reserved:\n            ip_type = 'reserved'\n        elif addr.is_private:\n            ip_type = 'private'\n        else:\n            ip_type = 'public'\n        \n        # 检查是否允许私有地址\n        if not allow_private and is_private:\n            return False, version, is_private, ip_type\n        \n        return True, version, is_private, ip_type\n        \n    except ValueError:\n        return False, 0, False, 'invalid'",
    "hash": "sha256:placeholder",
    "line_count": 35,
    "complexity": 3.5
  },
  "test_cases": [
    {
      "name": "valid_ipv4",
      "description": "有效的 IPv4 地址",
      "input": { "ip": "192.168.1.1", "allow_private": true },
      "expected": { "is_valid": true, "version": 4, "is_private": true, "type": "private" },
      "tags": ["happy_path", "ipv4", "private"]
    },
    {
      "name": "public_ipv4",
      "description": "公网 IPv4 地址",
      "input": { "ip": "8.8.8.8", "allow_private": true },
      "expected": { "is_valid": true, "version": 4, "is_private": false, "type": "public" },
      "tags": ["happy_path", "ipv4", "public"]
    },
    {
      "name": "valid_ipv6",
      "description": "有效的 IPv6 地址",
      "input": { "ip": "2001:0db8:85a3:0000:0000:8a2e:0370:7334", "allow_private": true },
      "expected": { "is_valid": true, "version": 6, "is_private": false, "type": "public" },
      "tags": ["happy_path", "ipv6"]
    },
    {
      "name": "loopback",
      "description": "本地回环地址",
      "input": { "ip": "127.0.0.1", "allow_private": true },
      "expected": { "is_valid": true, "version": 4, "is_private": true, "type": "loopback" },
      "tags": ["loopback"]
    },
    {
      "name": "invalid_ip",
      "description": "无效的 IP 地址",
      "input": { "ip": "256.1.1.1", "allow_private": true },
      "expected": { "is_valid": false, "version": 0, "is_private": false, "type": "invalid" },
      "tags": ["validation", "error"]
    },
    {
      "name": "reject_private",
      "description": "拒绝私有地址",
      "input": { "ip": "192.168.1.1", "allow_private": false },
      "expected": { "is_valid": false, "version": 4, "is_private": true, "type": "private" },
      "tags": ["validation", "private"]
    }
  ],
  "dependencies": [
    { "name": "ipaddress", "type": "builtin" },
    { "name": "typing", "type": "builtin" }
  ],
  "tags": ["ip", "validation", "network", "ipv4", "ipv6"],
  "categories": ["validation", "network"],
  "usage_scenarios": [
    "网络安全检查",
    "访问控制列表验证",
    "日志分析中的 IP 提取"
  ],
  "performance": {
    "time_complexity": "O(1)",
    "benchmarks": [
      { "dataset_size": "10000 IPs", "avg_time_ms": 0.02, "memory_mb": 1 }
    ]
  },
  "security": {
    "sandbox_required": false,
    "network_access": false,
    "filesystem_access": false,
    "risk_level": "low"
  },
