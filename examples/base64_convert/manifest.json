{
  "function_id": "func-008-base64-converter",
  "name": "base64_convert",
  "display_name": "Base64 编解码器",
  "description": "Base64 编码和解码，支持标准 Base64 和 URL-safe Base64，处理文本和二进制数据。",
  "language": "python",
  "version": "1.0.0",
  "signature": {
    "inputs": [
      {
        "name": "data",
        "type": "str",
        "description": "待编码/解码的数据",
        "required": true
      },
      {
        "name": "operation",
        "type": "str",
        "description": "操作类型（encode/decode）",
        "required": true
      },
      {
        "name": "url_safe",
        "type": "bool",
        "description": "是否使用 URL-safe 字符集",
        "required": false,
        "default": false
      }
    ],
    "outputs": [
      {
        "name": "success",
        "type": "bool",
        "description": "操作是否成功"
      },
      {
        "name": "result",
        "type": "str",
        "description": "编码/解码结果"
      },
      {
        "name": "error",
        "type": "str",
        "description": "错误信息（失败时）"
      }
    ]
  },
  "code": {
    "source": "import base64\nfrom typing import Tuple\n\ndef base64_convert(data: str, operation: str, url_safe: bool = False) -> Tuple[bool, str, str]:\n    \"\"\"\n    Base64 编码/解码。\n    \"\"\"\n    if not data:\n        return False, '', 'Empty input'\n    \n    try:\n        if operation == 'encode':\n            # 编码\n            encoded = data.encode('utf-8')\n            if url_safe:\n                result = base64.urlsafe_b64encode(encoded).decode('utf-8')\n            else:\n                result = base64.b64encode(encoded).decode('utf-8')\n            return True, result, ''\n        \n        elif operation == 'decode':\n            # 解码\n            if url_safe:\n                decoded = base64.urlsafe_b64decode(data.encode('utf-8'))\n            else:\n                decoded = base64.b64decode(data.encode('utf-8'))\n            result = decoded.decode('utf-8')\n            return True, result, ''\n        \n        else:\n            return False, '', f'Invalid operation: {operation}'\n    \n    except Exception as e:\n        return False, '', str(e)",
    "hash": "sha256:placeholder",
    "line_count": 32,
    "complexity": 2.5
  },
  "test_cases": [
    {
      "name": "encode_text",
      "description": "编码文本",
      "input": { "data": "Hello, World!", "operation": "encode", "url_safe": false },
      "expected": { "success": true, "result": "SGVsbG8sIFdvcmxkIQ==", "error": "" },
      "tags": ["happy_path", "encode"]
    },
    {
      "name": "decode_text",
      "description": "解码文本",
      "input": { "data": "SGVsbG8sIFdvcmxkIQ==", "operation": "decode", "url_safe": false },
      "expected": { "success": true, "result": "Hello, World!", "error": "" },
      "tags": ["happy_path", "decode"]
    },
    {
      "name": "url_safe_encode",
      "description": "URL-safe 编码",
      "input": { "data": "a+b/c", "operation": "encode", "url_safe": true },
      "expected": { "success": true, "result": "YS1iX2M=", "error": "" },
      "tags": ["url_safe", "encode"]
    },
    {
      "name": "invalid_decode",
