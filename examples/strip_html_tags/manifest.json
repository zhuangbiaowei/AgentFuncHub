{
  "function_id": "func-011-html-strip",
  "name": "strip_html_tags",
  "display_name": "HTML 标签剥离器",
  "description": "移除 HTML 标签，提取纯文本内容，支持保留换行格式。",
  "language": "python",
  "version": "1.0.0",
  "signature": {
    "inputs": [
      {
        "name": "html",
        "type": "str",
        "description": "HTML 字符串",
        "required": true
      },
      {
        "name": "keep_line_breaks",
        "type": "bool",
        "description": "是否保留换行格式（将<br>, <p> 等转为换行）",
        "required": false,
        "default": true
      },
      {
        "name": "trim_whitespace",
        "type": "bool",
        "description": "是否修剪多余空白",
        "required": false,
        "default": true
      }
    ],
    "outputs": [
      {
        "name": "text",
        "type": "str",
        "description": "纯文本内容"
      },
      {
        "name": "original_length",
        "type": "int",
        "description": "原始 HTML 长度"
      },
      {
        "name": "text_length",
        "type": "int",
        "description": "提取后文本长度"
      }
    ]
  },
  "code": {
    "source": "import re\nfrom typing import Tuple\n\ndef strip_html_tags(\n    html: str, \n    keep_line_breaks: bool = True,\n    trim_whitespace: bool = True\n) -> Tuple[str, int, int]:\n    \"\"\"\n    移除 HTML 标签，提取纯文本。\n    \"\"\"\n    if not html:\n        return '', 0, 0\n    \n    original_length = len(html)\n    text = html\n    \n    # 保留换行格式\n    if keep_line_breaks:\n        # 将块级元素替换为换行\n        block_tags = ['br', 'p', 'div', 'h[1-6]', 'li', 'tr']\n        for tag in block_tags:\n            text = re.sub(f'</?{tag}[^>]*>', '\\n', text, flags=re.IGNORECASE)\n    \n    # 移除所有 HTML 标签\n    text = re.sub(r'<[^>]+?>', '', text)\n    \n    # 解码 HTML 实体\n    import html\n    text = html.unescape(text)\n    \n    # 修剪空白\n    if trim_whitespace:\n        # 合并多个换行\n        text = re.sub(r'\\n+', '\\n', text)\n        # 合并多个空格\n        text = re.sub(r' +', ' ', text)\n        # 去除首尾空白\n        text = text.strip()\n    \n    return text, original_length, len(text)",
    "hash": "sha256:placeholder",
    "line_count": 42,
    "complexity": 2.5
  },
  "test_cases": [
    {
      "name": "simple_html",
      "description": "简单 HTML",
      "input": { "html": "<p>Hello <strong>World</strong>!</p>", "keep_line_breaks": true, "trim_whitespace": true },
      "expected": { "text": "Hello World!", "original_length": 43, "text_length": 12 },
      "tags": ["happy_path", "simple"]
    },
    {
      "name": "with_line_breaks",
      "description": "保留换行",
      "input": { "html": "<p>Line 1</p><p>Line 2</p>", "keep_line_breaks": true, "trim_whitespace": true },
      "expected": { "text": "Line 1\\nLine 2" },
      "tags": ["happy_path", "line_breaks"]
    },
    {
      "name": "html_entities",
      "description": "HTML 实体解码",
      "input": { "html": "&lt;div&gt;Test&lt;/div&gt;", "keep_line_breaks": false, "trim_whitespace": true },
      "expected": { "text": "<div>Test</div>" },
      "tags": ["entities", "decode"]
    },
    {
      "name": "empty_html",
      "description": "空 HTML",
      "input": { "html": "", "keep_line_breaks": true, "trim_whitespace": true },
      "expected": { "text": "", "original_length": 0, "text_length": 0 },
      "tags": ["edge_case"]
    },
    {
      "name": "no_html",
      "description": "纯文本",
      "input": { "html": "Just plain text", "keep_line_breaks": true, "trim_whitespace": true },
      "expected": { "text": "Just plain text" },
      "tags": ["happy_path"]
    }
  ],
  "dependencies": [
    { "name": "re", "type": "builtin" },
    { "name": "html", "type": "builtin" },
    { "name": "typing", "type": "builtin" }
  ],
  "tags": ["html", "text", "strip", "clean"],
  "categories": ["text_processing"],
  "usage_scenarios": [
