{
  "function_id": "func-020-file-size",
  "name": "format_file_size",
  "display_name": "文件大小格式化",
  "description": "将字节数转换为人类可读的文件大小字符串（KB/MB/GB等）。",
  "language": "python",
  "version": "1.0.0",
  "signature": {
    "inputs": [
      {
        "name": "size_bytes",
        "type": "int",
        "description": "字节数",
        "required": true
      },
      {
        "name": "precision",
        "type": "int",
        "description": "小数位数",
        "required": false,
        "default": 2
      },
      {
        "name": "binary",
        "type": "bool",
        "description": "使用二进制单位（1024）",
        "required": false,
        "default": true
      }
    ],
    "outputs": [
      {
        "name": "formatted",
        "type": "str",
        "description": "格式化后的文件大小"
      },
      {
        "name": "unit",
        "type": "str",
        "description": "单位（B/KB/MB/GB/TB）"
      },
      {
        "name": "value",
        "type": "float",
        "description": "数值"
      }
    ]
  },
  "code": {
    "source": "from typing import Tuple\n\ndef format_file_size(\n    size_bytes: int, \n    precision: int = 2,\n    binary: bool = True\n) -> Tuple[str, str, float]:\n    \"\"\"\n    格式化文件大小。\n    \"\"\"\n    if size_bytes < 0:\n        raise ValueError('Size must be non-negative')\n    \n    if size_bytes == 0:\n        return '0 B', 'B', 0.0\n    \n    base = 1024 if binary else 1000\n    units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB']\n    \n    size = float(size_bytes)\n    unit_index = 0\n    \n    while size >= base and unit_index < len(units) - 1:\n        size /= base\n        unit_index += 1\n    \n    unit = units[unit_index]\n    formatted = f'{size:.{precision}f} {unit}'\n    \n    return formatted, unit, round(size, precision)",
    "hash": "sha256:placeholder",
    "line_count": 26,
    "complexity": 2.0
  },
  "test_cases": [
    {
      "name": "bytes",
      "description": "字节",
      "input": { "size_bytes": 512, "precision": 2, "binary": true },
      "expected": { "formatted": "512.00 B", "unit": "B", "value": 512.0 },
      "tags": ["happy_path"]
    },
    {
      "name": "kilobytes",
      "description": "KB",
      "input": { "size_bytes": 1536, "precision": 2 },
      "expected": { "formatted": "1.50 KB", "unit": "KB" },
      "tags": ["happy_path", "kb"]
    },
    {
      "name": "megabytes",
      "description": "MB",
      "input": { "size_bytes": 10485760, "precision": 2 },
      "expected": { "formatted": "10.00 MB", "unit": "MB" },
      "tags": ["happy_path", "mb"]
    },
    {
      "name": "gigabytes",
      "description": "GB",
      "input": { "size_bytes": 1073741824, "precision": 2 },
      "expected": { "formatted": "1.00 GB", "unit": "GB" },
      "tags": ["happy_path", "gb"]
    },
    {
      "name": "decimal_units",
      "description": "十进制单位",
      "input": { "size_bytes": 1000, "binary": false },
      "expected": { "formatted": "1.00 KB", "unit": "KB" },
      "tags": ["decimal"]
    }
  ],
  "dependencies": [
