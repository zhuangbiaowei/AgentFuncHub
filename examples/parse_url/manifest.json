{
  "function_id": "func-015-url-parser",
  "name": "parse_url",
  "display_name": "URL 解析器",
  "description": "解析 URL 字符串，提取协议、域名、路径、查询参数等各个组成部分。",
  "language": "python",
  "version": "1.0.0",
  "signature": {
    "inputs": [
      {
        "name": "url",
        "type": "str",
        "description": "URL 字符串",
        "required": true
      },
      {
        "name": "decode_params",
        "type": "bool",
        "description": "是否解码查询参数",
        "required": false,
        "default": true
      }
    ],
    "outputs": [
      {
        "name": "valid",
        "type": "bool",
        "description": "URL 是否有效"
      },
      {
        "name": "components",
        "type": "dict",
        "description": "URL 各个组成部分"
      }
    ]
  },
  "code": {
    "source": "from urllib.parse import urlparse, parse_qs, unquote\nfrom typing import Tuple, Dict, Any\n\ndef parse_url(url: str, decode_params: bool = True) -> Tuple[bool, Dict[str, Any]]:\n    \"\"\"\n    解析 URL。\n    \"\"\"\n    if not url:\n        return False, {}\n    \n    try:\n        parsed = urlparse(url)\n        \n        # 解析查询参数\n        query_params = parse_qs(parsed.query)\n        \n        if decode_params:\n            # 解码参数值\n            query_params = {\n                k: [unquote(v) for v in vals] \n                for k, vals in query_params.items()\n            }\n        \n        components = {\n            'scheme': parsed.scheme,\n            'netloc': parsed.netloc,\n            'hostname': parsed.hostname,\n            'port': parsed.port,\n            'path': parsed.path,\n            'params': parsed.params,\n            'query': parsed.query,\n            'query_params': query_params,\n            'fragment': parsed.fragment,\n            'username': parsed.username,\n            'password': parsed.password\n        }\n        \n        return True, components\n        \n    except Exception as e:\n        return False, {'error': str(e)}",
    "hash": "sha256:placeholder",
    "line_count": 42,
    "complexity": 2.5
  },
  "test_cases": [
    {
      "name": "full_url",
      "description": "完整URL",
      "input": { "url": "https://example.com:8080/path?key=value&foo=bar#section", "decode_params": true },
      "expected": { "valid": true },
      "tags": ["happy_path", "full"]
    },
    {
      "name": "simple_url",
      "description": "简单URL",
      "input": { "url": "https://example.com", "decode_params": true },
      "expected": { "valid": true, "components": { "scheme": "https", "hostname": "example.com" } },
      "tags": ["happy_path", "simple"]
    },
    {
      "name": "url_with_auth",
      "description": "带认证的URL",
      "input": { "url": "https://user:pass@example.com", "decode_params": true },
      "expected": { "valid": true, "components": { "username": "user", "password": "pass" } },
      "tags": ["auth"]
    },
    {
      "name": "encoded_params",
      "description": "编码的参数",
      "input": { "url": "https://example.com?q=hello%20world", "decode_params": true },
      "expected": { "valid": true },
      "tags": ["encoding"]
    },
    {
      "name": "invalid_url",
      "description": "无效URL",
      "input": { "url": "not a url", "decode_params": true },
      "expected": { "valid": false },
      "tags": ["validation", "error"]
    }
  ],
  "dependencies": [
    { "name": "urllib.parse", "type": "builtin" },
    { "name": "typing", "type": "builtin" }
  ],
  "tags": ["url", "parse", "network", "extract"],
  "categories": ["network", "format_conversion"],
  "usage_scenarios": [
    "URL 分析",
    "API 端点解析",
    "请求路由"
  ],
  "performance": {
    "time_complexity": "O(1)",
    "benchmarks": [
      { "dataset_size": "10000 URLs", "avg_time_ms": 0.1, "memory_mb": 1 }
    ]
  },
