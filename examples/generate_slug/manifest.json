{
  "function_id": "func-002-slug-generator",
  "name": "generate_slug",
  "display_name": "URL 友好字符串生成器",
  "description": "将任意字符串转换为 URL 友好的 slug 格式。支持多语言（包括中文）、自定义分隔符、最大长度限制。",
  "language": "python",
  "version": "1.0.0",
  "signature": {
    "inputs": [
      {
        "name": "text",
        "type": "str",
        "description": "原始字符串",
        "required": true
      },
      {
        "name": "separator",
        "type": "str",
        "description": "单词之间的分隔符",
        "required": false,
        "default": "-"
      },
      {
        "name": "max_length",
        "type": "int",
        "description": "最大长度限制，0 表示不限制",
        "required": false,
        "default": 0,
        "constraints": {
          "min": 0,
          "max": 500
        }
      },
      {
        "name": "allow_unicode",
        "type": "bool",
        "description": "是否保留 Unicode 字符（如中文）",
        "required": false,
        "default": false
      }
    ],
    "outputs": [
      {
        "name": "slug",
        "type": "str",
        "description": "生成的 URL 友好字符串"
      }
    ]
  },
  "code": {
    "source": "import re\nimport unicodedata\nfrom typing import Optional\n\ndef generate_slug(\n    text: str, \n    separator: str = '-',\n    max_length: int = 0,\n    allow_unicode: bool = False\n) -> str:\n    \"\"\"\n    将字符串转换为 URL 友好的 slug。\n    \"\"\"\n    if not text:\n        return ''\n    \n    # Unicode 规范化\n    text = unicodedata.normalize('NFKC', text)\n    \n    if not allow_unicode:\n        # 转 ASCII，移除重音符号\n        text = text.encode('ascii', 'ignore').decode('ascii')\n    \n    # 转换为小写\n    text = text.lower()\n    \n    # 替换分隔符\n    text = re.sub(r'[^\\w\\s-]', '', text)\n    text = re.sub(r'[-\\s]+', separator, text)\n    \n    # 去除首尾分隔符\n    text = text.strip(separator)\n    \n    # 截断\n    if max_length > 0 and len(text) > max_length:\n        text = text[:max_length].rsplit(separator, 1)[0]\n    \n    return text",
    "hash": "sha256:placeholder",
    "line_count": 35,
    "complexity": 3.0
  },
  "test_cases": [
    {
      "name": "simple_english",
      "description": "简单英文",
      "input": { "text": "Hello World", "separator": "-", "max_length": 0, "allow_unicode": false },
      "expected": { "slug": "hello-world" },
      "tags": ["happy_path", "english"]
    },
    {
      "name": "chinese_with_unicode",
      "description": "中文保留",
      "input": { "text": "你好世界", "separator": "-", "max_length": 0, "allow_unicode": true },
      "expected": { "slug": "你好世界" },
      "tags": ["chinese", "unicode"]
    },
    {
      "name": "chinese_to_ascii",
      "description": "中文转 ASCII（会丢失）",
      "input": { "text": "你好世界", "separator": "-", "max_length": 0, "allow_unicode": false },
      "expected": { "slug": "" },
      "tags": ["chinese", "ascii"]
    },
    {
      "name": "with_special_chars",
      "description": "包含特殊字符",
      "input": { "text": "Hello, World! How are you?", "separator": "-", "max_length": 0, "allow_unicode": false },
      "expected": { "slug": "hello-world-how-are-you" },
      "tags": ["special_chars"]
    },
    {
      "name": "max_length_truncation",
      "description": "长度截断",
      "input": { "text": "this is a very long title that needs truncation", "separator": "-", "max_length": 20, "allow_unicode": false },
      "expected": { "slug": "this-is-a-very-long" },
      "tags": ["truncation"]
    }
  ],
  "dependencies": [
    { "name": "re", "type": "builtin" },
    { "name": "unicodedata", "type": "builtin" },
    { "name": "typing", "type": "builtin" }
  ],
  "tags": ["text", "url", "slug", "string", "format"],
  "categories": ["text_processing"],
  "usage_scenarios": [
    "博客文章 URL 生成",
    "产品页面 slug",
    "文件重命名"
  ],
  "performance": {
    "time_complexity": "O(n)",
    "space_complexity": "O(n)",
    "benchmarks": [
      { "dataset_size": "1000 strings", "avg_time_ms": 0.2, "memory_mb": 1 }
    ]
  },
