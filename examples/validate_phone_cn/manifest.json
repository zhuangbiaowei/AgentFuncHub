{
  "function_id": "func-003-phone-validator",
  "name": "validate_phone_cn",
  "display_name": "中国手机号验证器",
  "description": "验证中国大陆手机号格式，支持三大运营商（移动、联通、电信）及虚拟运营商号码。",
  "language": "python",
  "version": "1.0.0",
  "signature": {
    "inputs": [
      {
        "name": "phone",
        "type": "str",
        "description": "待验证的手机号",
        "required": true
      },
      {
        "name": "strict",
        "type": "bool",
        "description": "是否严格验证号段",
        "required": false,
        "default": false
      }
    ],
    "outputs": [
      {
        "name": "is_valid",
        "type": "bool",
        "description": "是否为有效手机号"
      },
      {
        "name": "carrier",
        "type": "str",
        "description": "运营商（mobile/unicom/telecom/virtual/unknown）"
      },
      {
        "name": "formatted",
        "type": "str",
        "description": "格式化后的手机号（如 138-1234-5678）"
      }
    ]
  },
  "code": {
    "source": "import re\nfrom typing import Tuple\n\ndef validate_phone_cn(phone: str, strict: bool = False) -> Tuple[bool, str, str]:\n    \"\"\"\n    验证中国大陆手机号格式。\n    \"\"\"\n    # 清理输入\n    phone = str(phone).strip().replace('-', '').replace(' ', '')\n    \n    # 基本格式检查\n    if not phone.isdigit():\n        return False, 'invalid', ''\n    \n    # 长度检查\n    if len(phone) != 11:\n        return False, 'invalid', ''\n    \n    # 必须以1开头\n    if not phone.startswith('1'):\n        return False, 'invalid', ''\n    \n    # 运营商号段\n    patterns = {\n        'mobile': r'^1(3[4-9]|4[7]|5[0-27-9]|7[8]|8[2-478])\\d{8}$',\n        'unicom': r'^1(3[0-2]|4[5]|5[56]|6[6]|7[56]|8[56]|9[6])\\d{8}$',\n        'telecom': r'^1(33|49|53|7[37]|8[019]|9[0139])\\d{8}$',\n        'virtual': r'^17[01]\\d{8}$'\n    }\n    \n    for carrier, pattern in patterns.items():\n        if re.match(pattern, phone):\n            formatted = f'{phone[:3]}-{phone[3:7]}-{phone[7:]}'\n            return True, carrier, formatted\n    \n    # 非严格模式下接受所有 1 开头的 11 位数字\n    if not strict:\n        formatted = f'{phone[:3]}-{phone[3:7]}-{phone[7:]}'\n        return True, 'unknown', formatted\n    \n    return False, 'invalid', ''",
    "hash": "sha256:placeholder",
    "line_count": 45,
    "complexity": 5.0
  },
  "test_cases": [
    {
      "name": "mobile_138",
      "description": "中国移动 138 号段",
      "input": { "phone": "13812345678", "strict": false },
      "expected": { "is_valid": true, "carrier": "mobile", "formatted": "138-1234-5678" },
      "tags": ["happy_path", "mobile"]
    },
    {
      "name": "unicom_186",
      "description": "中国联通 186 号段",
      "input": { "phone": "18612345678", "strict": false },
      "expected": { "is_valid": true, "carrier": "unicom", "formatted": "186-1234-5678" },
      "tags": ["happy_path", "unicom"]
    },
    {
      "name": "telecom_189",
      "description": "中国电信 189 号段",
      "input": { "phone": "18912345678", "strict": false },
      "expected": { "is_valid": true, "carrier": "telecom", "formatted": "189-1234-5678" },
      "tags": ["happy_path", "telecom"]
    },
    {
      "name": "with_hyphen",
      "description": "带横线的手机号",
      "input": { "phone": "138-1234-5678", "strict": false },
      "expected": { "is_valid": true, "carrier": "mobile", "formatted": "138-1234-5678" },
      "tags": ["formatting"]
    },
    {
      "name": "too_short",
      "description": "号码长度不足",
      "input": { "phone": "138123", "strict": false },
      "expected": { "is_valid": false, "carrier": "invalid", "formatted": "" },
      "tags": ["validation", "error"]
    },
    {
      "name": "invalid_chars",
      "description": "包含非数字字符",
      "input": { "phone": "1381234abcd", "strict": false },
      "expected": { "is_valid": false, "carrier": "invalid", "formatted": "" },
      "tags": ["validation", "error"]
    }
  ],
  "dependencies": [
    { "name": "re", "type": "builtin" },
    { "name": "typing", "type": "builtin" }
  ],
  "tags": ["phone", "validation", "china", "mobile"],
  "categories": ["validation"],
  "usage_scenarios": [
